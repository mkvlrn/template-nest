{
  "name": "template-nest",
  "description": "A revamped/modernized template for NestJS projects using esm",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": "Mike Valeriano <mkvlrn@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git@github.com:mkvlrn/template-nest"
  },
  "keywords": [
    "nestjs",
    "esm",
    "template"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0"
    }
  },
  "imports": {
    "#/*": "./src/*.ts"
  },
  "devDependencies": {
    "@mkvlrn/config": "0.5.1",
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.6",
    "@types/node": "26.3.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@mkvlrn/app-error": "0.4.4",
    "@mkvlrn/result": "0.3.5",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "varlock": "1.17.1"
  }
}
